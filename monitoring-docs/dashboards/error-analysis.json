        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 3,
      "title": "🔥 Error Rate Pattern by Time of Day (Heatmap)",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (le) (rate(brainbytes_http_request_duration_seconds_bucket{status=~\"[45]..\"}[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "color": {
          "cardinality": 8,
          "color": "orange",
          "exponent": 0.5,
          "fill": "dark-orange",
          "mode": "spectrum",
          "reverse": false,
          "scale": "log2",
          "scheme": "Oranges"
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-9,
          "to": 0.001
        },
        "rowsFrame": {
          "layout": "list"
        },
        "showLegend": true,
        "tooltip": {
          "show": true,
          "yDecimals": 2
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 4,
      "title": "📋 Recent Application Errors Log Summary",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(brainbytes_errors_total[1h])) by (error_type, source, severity)",
          "legendFormat": "{{error_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": true,
          "fields": [],
          "reducer": [
            "sum"
          ],
          "show": true
        },
        "showHeader": true
      }
