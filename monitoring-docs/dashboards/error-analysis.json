          },
          "editorMode": "code",
          "expr": "sum(increase(brainbytes_ai_errors_total[1h])) by (error_type, category)",
          "legendFormat": "{{error_type}} - {{category}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
