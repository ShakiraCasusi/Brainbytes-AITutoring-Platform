      "id": 1,
      "title": "🟢 Service Status Timeline",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=~\"$service\", instance=~\"$instance\"}",
          "legendFormat": "{{job}} ({{instance}})",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "fillOpacity": 70,
            "lineWidth": 1,
            "spanNulls": false
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "alignValue": "left",
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "always",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
