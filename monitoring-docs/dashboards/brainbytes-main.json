      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(rate(brainbytes_http_requests_total{status=~\"2..\", endpoint=~\"$endpoint\"}[5m])) / sum(rate(brainbytes_http_requests_total{endpoint=~\"$endpoint\"}[5m]))",
          "legendFormat": "Success Rate",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
